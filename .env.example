# Environment Configuration for GRANTLY — Unified Scholarship Discovery & Management Platform
# Copy this file to .env for local or cloud server deployments.

# GEMINI_API_KEY: Optional server-side API key if server-side document/scheme endpoints are enabled.
GEMINI_API_KEY="YOUR_API_KEY"

# APP_URL: The public base URL where GRANTLY is hosted (e.g., https://grantly.yourdomain.com).
APP_URL="http://localhost:3000"
